[Unit]
Description=Epic wallet listener: foreign API 127.0.0.1:3415, receives the block rewards from the node
After=epic-node.service
Wants=epic-node.service

[Service]
Type=simple
User=epicpool
WorkingDirectory=/opt/epic-wallet
# the wallet password is typed at the wallet prompt through a pty (deployment/wallet/run-wallet.py), it never appears in argv
ExecStart=/usr/bin/python3 /opt/epic-nodejs-pool/deployment/wallet/run-wallet.py /opt/epic-wallet listen --no_tor
Restart=always
RestartSec=30
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
