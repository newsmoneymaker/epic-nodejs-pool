[Unit]
Description=Epic Cash pool: payment processor (pays balances from the pool wallet over epicbox; emergency brake: deployment/pause-payments.sh)
After=epic-pool-redis.service epic-node.service epic-wallet-owner.service epic-wallet-epicbox.service
Requires=epic-pool-redis.service
[Service]
Type=simple
User=epicpool
WorkingDirectory=/opt/epic-nodejs-pool
ExecStart=/usr/bin/node /opt/epic-nodejs-pool/init.js -module=payments
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# ports below 1024 (for example 993) need this:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
