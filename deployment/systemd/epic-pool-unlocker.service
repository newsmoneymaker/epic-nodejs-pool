[Unit]
Description=Epic Cash pool: block unlocker (credits balances after 1440 blocks; sends nothing)
After=epic-pool-redis.service epic-node.service epic-wallet-owner.service
Requires=epic-pool-redis.service
[Service]
Type=simple
User=epicpool
WorkingDirectory=/opt/epic-nodejs-pool
ExecStart=/usr/bin/node /opt/epic-nodejs-pool/init.js -module=unlocker
Restart=always
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# ports below 1024 (for example 993) need this:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
